{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Commerce agent tools",
  "description": "Read-only tools callable by the Agent; writes are preview/confirm actions driven by the BFF.",
  "tools": {
    "search_products": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": { "type": "string", "maxLength": 200 },
        "brandId": { "type": "integer" },
        "categoryId": { "type": "integer" },
        "pageNum": { "type": "integer", "minimum": 1 },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 20 },
        "sort": { "type": "integer", "enum": [0, 1, 2, 3, 4] }
      }
    },
    "get_product_detail": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "productId": { "type": "integer" } },
      "required": ["productId"]
    },
    "get_user_orders": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "type": "integer", "default": -1 },
        "pageNum": { "type": "integer", "minimum": 1 },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 50 }
      }
    },
    "get_order_detail": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "orderId": { "type": "integer" } },
      "required": ["orderId"]
    },
    "get_logistics": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "orderId": { "type": "integer" } },
      "required": ["orderId"]
    },
    "get_after_sale_status": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "afterSaleId": { "type": "integer" } },
      "required": ["afterSaleId"]
    }
  }
}
