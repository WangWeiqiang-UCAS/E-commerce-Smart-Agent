AGENT_RUNTIME_URL=http://localhost:8000
COMMERCE_API_URL=http://localhost:8085
PUBLIC_APP_ORIGIN=http://localhost:3000
# Secure HttpOnly cookie names issued by the unified authentication/BFF login flow.
AGENT_SESSION_COOKIE=agent_access_token
COMMERCE_SESSION_COOKIE=commerce_access_token
SESSION_COOKIE_SECURE=false
BFF_TO_AGENT_SHARED_SECRET=replace-with-the-agent-bff-secret
