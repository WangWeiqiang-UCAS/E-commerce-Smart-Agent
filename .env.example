PROJECT_NAME=E-commerce Smart Agent Prototype
API_V1_STR=/api/v1
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_DB=knowledge_base
POSTGRES_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-your-api-key
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
LLM_TIMEOUT_SECONDS=60
# Java commerce API; required for order and after-sales Agent tools.
COMMERCE_API_BASE_URL=http://commerce-java:8085
COMMERCE_API_TIMEOUT_SECONDS=8
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//
COMMERCE_EVENT_QUEUE=agent.runtime.events
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
# Per-user Agent chat rate limit (in-process; Redis-backed in production).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
# Set this to a long random secret in every deployed environment.
BFF_SHARED_SECRET=replace-with-a-long-random-bff-secret
# Generate a unique value for every non-local environment.
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Comma-separated browser origins; never use * when credentials are enabled.
CORS_ORIGINS=http://localhost:3000
