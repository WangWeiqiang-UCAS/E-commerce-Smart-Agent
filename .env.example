PROJECT_NAME=E-commerce Smart Agent Prototype
API_V1_STR=/api/v1
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
POSTGRES_DB=knowledge_base
POSTGRES_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-your-api-key
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
LLM_TIMEOUT_SECONDS=60
# Java commerce API; required for order and after-sales Agent tools.
COMMERCE_API_BASE_URL=http://commerce-java:8085
COMMERCE_API_TIMEOUT_SECONDS=8
RABBITMQ_URL=amqp://agent_runtime:replace-with-a-long-random-rabbitmq-password@rabbitmq:5672//
COMMERCE_EVENT_QUEUE=agent.runtime.events
RABBITMQ_DEFAULT_USER=agent_runtime
RABBITMQ_DEFAULT_PASS=replace-with-a-long-random-rabbitmq-password
MALL_MYSQL_ROOT_PASSWORD=replace-with-a-long-random-mysql-root-password
MALL_MYSQL_USER=mall_app
MALL_MYSQL_PASSWORD=replace-with-a-long-random-mysql-app-password
# Per-user Agent chat rate limit (Redis-backed, with a local outage fallback).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_REDIS_TIMEOUT_SECONDS=0.25
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=agent-runtime
# Required when starting deploy/observability/docker-compose.observability.yaml.
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-grafana-password
MINIO_ACCESS_KEY=replace-with-a-minio-access-key
MINIO_SECRET_KEY=replace-with-a-long-random-minio-secret
MINIO_EVIDENCE_BUCKET=commerce-evidence
# Set this to a long random secret in every deployed environment.
BFF_SHARED_SECRET=replace-with-a-long-random-bff-secret
# Generate with: poetry run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=replace-with-a-32-byte-url-safe-fernet-key
# Required by the Java commerce Compose/prod profiles; use a distinct high-entropy value.
COMMERCE_JWT_SECRET=replace-with-a-long-random-commerce-jwt-secret
# Required only when SPRING_PROFILES_ACTIVE=prod. Inject these through a secret
# store in real deployments; placeholders here must never be deployed as-is.
COMMERCE_DB_URL=jdbc:mysql://db.example.internal:3306/mall?useUnicode=true&characterEncoding=utf-8&serverTimezone=UTC&useSSL=true
COMMERCE_DB_USERNAME=replace-me
COMMERCE_DB_PASSWORD=replace-me
COMMERCE_MONGO_HOST=mongo.example.internal
COMMERCE_MONGO_DATABASE=mall-port
COMMERCE_REDIS_HOST=redis.example.internal
COMMERCE_REDIS_PASSWORD=replace-me
COMMERCE_RABBITMQ_HOST=rabbitmq.example.internal
COMMERCE_RABBITMQ_VHOST=/mall
COMMERCE_RABBITMQ_USERNAME=replace-me
COMMERCE_RABBITMQ_PASSWORD=replace-me
DRUID_ADMIN_USERNAME=replace-me
DRUID_ADMIN_PASSWORD=replace-me
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
ALIPAY_APP_ID=replace-me
ALIPAY_PUBLIC_KEY=replace-me
ALIPAY_PRIVATE_KEY=replace-me
ALIPAY_RETURN_URL=https://store.example.com/payment/return
ALIPAY_NOTIFY_URL=https://commerce.example.internal/alipay/notify
# Generate a unique value for every non-local environment.
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Comma-separated browser origins; never use * when credentials are enabled.
CORS_ORIGINS=http://localhost:3000
